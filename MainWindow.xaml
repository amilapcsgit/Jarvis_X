<Window x:Class="Jarvis.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Jarvis 2" Width="1420" Height="900" MinWidth="900" MinHeight="600" Background="#060e19"
 Foreground="#e7f2fd" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="67"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Background="#091726" BorderBrush="#1f394a" BorderThickness="0,0,0,1">
   <DockPanel LastChildFill="True" Margin="22,0">
    <Button x:Name="StopButton" DockPanel.Dock="Right" Click="Stop" Background="#a91f39" Foreground="White"
       BorderBrush="#f97085" Padding="18,0" Height="36" FontWeight="SemiBold" Content="■  Emergency Stop"
       ToolTip="Interrupt the active run and release the desktop. Esc also stops the run.">
     <Button.Template>
      <ControlTemplate TargetType="Button">
       <Border x:Name="StopFace" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StopFace" Property="Background" Value="#c52444"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="StopFace" Property="Background" Value="#85152e"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StopFace" Property="BorderBrush" Value="#ffd0d8"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate>
     </Button.Template>
    </Button>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="◈" FontSize="23" Foreground="#62e8ef" VerticalAlignment="Center" Margin="0,0,11,0"/>
     <TextBlock Text="JARVIS" FontSize="20" FontWeight="Bold" Foreground="#e6f7ff" VerticalAlignment="Center"/>
     <TextBlock x:Name="NativeStatus" Text="Starting workspace" TextTrimming="CharacterEllipsis" Foreground="#9eb6c8"
        VerticalAlignment="Center" Margin="18,0,15,0" MaxWidth="650"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <TextBlock x:Name="WebError" Text="Opening the local Reactor workspace…" Margin="24" TextWrapping="Wrap"/>
   <web:WebView2 x:Name="Workspace" Visibility="Hidden" DefaultBackgroundColor="#060e19"/>
  </Grid>
 </Grid>
</Window>
